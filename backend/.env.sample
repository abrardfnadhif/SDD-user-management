# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/user_management
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# Optional: Redis for distributed rate limiting
# REDIS_URL=redis://localhost:6379/0

# Email Service (for verification links)
EMAIL_PROVIDER=console  # console|smtp|sendgrid|ses|postmark
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=User Management
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=
# AWS_SES_REGION=us-east-1
# POSTMARK_API_KEY=

# Application Environment
APP_ENV=development  # development, staging, production
ENABLE_DOCS=true     # Set to false in production for security  # development|staging|production
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO  # DEBUG|INFO|WARNING|ERROR|CRITICAL

# 2FA
TOTP_ISSUER=UserManagement
TOTP_BACKUP_CODES_COUNT=10

# Account Deletion
DELETION_GRACE_PERIOD_DAYS=14
DELETION_COMPLETE_DAYS=30
BACKUP_RETENTION_DAYS=90

# Security Headers
ENABLE_SECURITY_HEADERS=true
CSP_POLICY=default-src 'self'
HSTS_MAX_AGE=31536000
